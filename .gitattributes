# Line endings: Windows scripts/manifests are CRLF, Rust sources and docs are LF,
# and binaries (the embedded co-op server DLLs/exe) stay untouched.
*.cmd text eol=crlf
*.manifest text eol=crlf
*.ini text eol=crlf
*.cfg text eol=crlf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf

*.exe binary
*.dll binary
*.zip binary
*.png binary
*.ico binary

# GitHub Linguist hints
Cargo.lock linguist-generated=true
vendor/** linguist-vendored
